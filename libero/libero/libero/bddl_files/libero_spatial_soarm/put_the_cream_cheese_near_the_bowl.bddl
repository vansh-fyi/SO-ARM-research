(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the cream cheese near the bowl)
    (:regions
      (akita_black_bowl_region
          (:target main_table)
          (:ranges (
              (-0.21 -0.04 -0.19 -0.02)
            )
          )
      )
      (cream_cheese_region
          (:target main_table)
          (:ranges (
              (-0.05 0.02 -0.03 0.04)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    cream_cheese_1 - cream_cheese
  )

  (:obj_of_interest
    cream_cheese_1
    akita_black_bowl_1
  )

  (:init
    (On akita_black_bowl_1 main_table_akita_black_bowl_region)
    (On cream_cheese_1 main_table_cream_cheese_region)
  )

  (:goal
    (And (NearTo cream_cheese_1 akita_black_bowl_1))
  )

)
