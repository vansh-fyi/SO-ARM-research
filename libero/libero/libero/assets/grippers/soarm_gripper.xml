<?xml version="1.0" ?>
<!-- SOARM parallel-jaw gripper MJCF (SPIKE upgrade), robosuite 1.4 / MuJoCo 2.3.7.

     Replaces the stock single-jaw SO101 gripper (too small to grasp any LIBERO
     object) with the open-source roboninecom SO-ARM100/101 PARALLEL gripper
     (84 mm stroke, 120 N, same STS3215 servo). Upstream:
     https://github.com/roboninecom/SO-ARM100-101-Parallel-Gripper

     Structure mirrors robosuite's panda_gripper.xml (two prismatic fingers, one
     actuator each, single 1-D gripper action collapsed in SoarmGripper.format_action):
       - root body "right_gripper" at identity (attaches onto the arm's right_hand)
       - the arm holds a FIXED tool orientation at home: gripper local X -> world
         +Z, local Y -> world +Y, local Z -> world -X. So the fingers extend along
         local -X (= straight DOWN in the world, for a top-down grasp) and open
         along local Y (= world-horizontal). The grip_site (eef) sits BETWEEN the
         downward fingers so the Phase-4 FSM (which servos grip_site to the object)
         drives a top-down approach.
       - two symmetric slide jaws, 0..0.065 m each => 0.130 m max opening.
         DEVIATION from the real 84 mm stroke: the target akita_black_bowl is
         ~0.11 m across and hollow, so an 84 mm jaw cannot surround it and closing
         from inside the rim loses contact. The stroke was widened so the jaws
         surround-and-squeeze this bowl, proving the pick-place pipeline. For
         sim-to-real fidelity, keep 84 mm and grasp sub-84 mm objects (or rim-pinch).
       - box collision "jaws" (clean convex contact, condim=4, high friction) drive
         the physics; the real roboninecom clamp meshes are attached as VISUALS
         (group 1, contype/conaffinity 0) recentred onto each finger for fidelity
       - ft_frame site + force/torque sensors (SingleArm.control reads them each step)

     Fidelity note: the upstream clamp STLs are baked in full-arm-assembly
     coordinates; the visual geoms recentre them via a 180deg rotation about
     (1,1,0) (quat 0 0.7071 0.7071 0: mesh +y -> local +X finger axis, mesh x ->
     local Y opening) plus a computed translation. Grip physics use box pads, as
     robosuite itself does for the Panda/Robotiq fingerpads. -->
<mujoco model="soarm_gripper">
    <asset>
        <mesh name="soarm_clamp_left" file="soarm_parallel/clamp_1_visual.stl" scale="0.001 0.001 0.001"/>
        <mesh name="soarm_clamp_right" file="soarm_parallel/clamp_2_visual.stl" scale="0.001 0.001 0.001"/>
        <material name="soarm_jaw_material" rgba="0.75 0.78 0.8 1"/>
    </asset>
    <actuator>
        <!-- One position actuator per jaw. current_action=-1 => ctrl 0 (closed),
             +1 => ctrl 0.065 (open); see SoarmGripper.format_action.
             kp high + strong forcerange to emulate the 120 N grip spec. -->
        <position ctrllimited="true" ctrlrange="0 0.065" joint="gripper_left" kp="1000" name="gripper_left" forcelimited="true" forcerange="-60 60"/>
        <position ctrllimited="true" ctrlrange="0 0.065" joint="gripper_right" kp="1000" name="gripper_right" forcelimited="true" forcerange="-60 60"/>
    </actuator>
    <worldbody>
        <body name="right_gripper" pos="0 0 0" quat="1 0 0 0">
            <site name="ft_frame" pos="0 0 0" size="0.01 0.01 0.01" rgba="1 0 0 1" type="sphere" group="1"/>
            <!-- Mount/base share of the assembly mass (~0.17 kg total; the two
                 jaws carry the rest). -->
            <inertial pos="0 0 -0.03" mass="0.07" diaginertia="6e-05 6e-05 4e-05"/>
            <!-- EEF / grip_site sits BETWEEN the downward fingers. At the arm's
                 fixed home tool pose local -X -> world -Z, so the grip point is
                 placed along local -X (= straight down in the world). -->
            <body name="eef" pos="-0.052 -0.0002 0.0" quat="1 0 0 0">
                <site name="grip_site" pos="0 0 0" size="0.01 0.01 0.01" rgba="1 0 0 0.5" type="sphere" group="1"/>
                <site name="ee" pos="0 0 0" size="0.01 0.01 0.01" rgba="0 0 1 0" type="sphere" group="1"/>
                <site name="ee_x" pos="0.1 0 0" size="0.005 .1" quat="0.707105 0 0.707108 0" rgba="1 0 0 0" type="cylinder" group="1"/>
                <site name="ee_y" pos="0 0.1 0" size="0.005 .1" quat="0.707105 0.707108 0 0" rgba="0 1 0 0" type="cylinder" group="1"/>
                <site name="ee_z" pos="0 0 0.1" size="0.005 .1" quat="1 0 0 0" rgba="0 0 1 0" type="cylinder" group="1"/>
                <site name="grip_site_cylinder" pos="0 0 0" size="0.005 10" rgba="0 1 0 0.3" type="cylinder" group="1"/>
            </body>
            <!-- Fingers extend along LOCAL -X (= world -Z, DOWN, at the arm's fixed
                 home tool orientation: local X->world+Z, local Y->world+Y,
                 local Z->world-X). Opening is along LOCAL Y (= world +Y,
                 horizontal). Grip line: local (x in [-0.03,-0.10], y=-0.0002).
                 Real roboninecom clamp meshes attached as VISUALS via a 180deg
                 rotation about (1,1,0) (quat 0 0.7071 0.7071 0): mesh finger-length
                 (mesh +y) -> local +X, mesh opening (mesh x) -> local Y. -->
            <!-- LEFT jaw: opens toward -y (axis 0 -1 0), range 0..0.065. -->
            <body name="gripper_left_jaw" pos="0 0 0" quat="1 0 0 0">
                <joint name="gripper_left" type="slide" axis="0 -1 0" limited="true" range="0 0.065" damping="50" armature="1.0" frictionloss="0.5"/>
                <inertial pos="-0.052 -0.0092 0" mass="0.05" diaginertia="4e-05 4e-05 1e-05"/>
                <geom type="mesh" mesh="soarm_clamp_left" material="soarm_jaw_material" contype="0" conaffinity="0" group="1" pos="0.15241 -0.02808 0.15206" quat="0 0.707107 0.707107 0" name="left_jaw_visual"/>
                <!-- box collision jaw (fingers point down, local -X): inner (+y) face at grip line y=-0.0002 -->
                <geom type="box" size="0.022 0.009 0.020" pos="-0.052 -0.0092 0" group="0" contype="1" conaffinity="1" condim="4" solref="0.01 1" friction="2 0.05 0.0001" name="left_jaw_collision"/>
            </body>
            <!-- RIGHT jaw: opens toward +y (axis 0 1 0), range 0..0.065. -->
            <body name="gripper_right_jaw" pos="0 0 0" quat="1 0 0 0">
                <joint name="gripper_right" type="slide" axis="0 1 0" limited="true" range="0 0.065" damping="50" armature="1.0" frictionloss="0.5"/>
                <inertial pos="-0.052 0.0088 0" mass="0.05" diaginertia="4e-05 4e-05 1e-05"/>
                <geom type="mesh" mesh="soarm_clamp_right" material="soarm_jaw_material" contype="0" conaffinity="0" group="1" pos="0.15242 0.01270 0.15171" quat="0 0.707107 0.707107 0" name="right_jaw_visual"/>
                <geom type="box" size="0.022 0.009 0.020" pos="-0.052 0.0088 0" group="0" contype="1" conaffinity="1" condim="4" solref="0.01 1" friction="2 0.05 0.0001" name="right_jaw_collision"/>
            </body>
        </body>
    </worldbody>
    <sensor>
        <force name="force_ee" site="ft_frame"/>
        <torque name="torque_ee" site="ft_frame"/>
    </sensor>
</mujoco>
