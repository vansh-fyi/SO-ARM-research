<?xml version="1.0" ?>
<!-- SOARM SO101 gripper MJCF, adapted for robosuite 1.4 / MuJoCo 2.3.7.
     Contains exactly the jaw parts excluded from the plan 02-01 arm split
     (so101_new_calib.source.xml, pinned commit in ../robots/soarm101/VENDOR.txt):
     the fixed-jaw geoms (wrist_roll_follower_so101_v1) and the
     moving_jaw_so101_v1 body with its "gripper" hinge joint and position
     actuator. Structural contract mirrors robosuite panda_gripper.xml:
     - root body "right_gripper" at identity pose (attaches onto the arm's
       right_hand body, which IS the source gripper body frame — jaw parts
       keep their source-relative pos/quat)
     - body "eef" at the source gripperframe site position with grip_site,
       grip_site_cylinder, ee/ee_x/ee_y/ee_z sites (SingleArm._setup_references
       and GripperModel.__init__ hard requirements)
     - ft_frame site + force_ee/torque_ee sensors (SingleArm.control reads
       them every step)
     - single <position> actuator on the jaw joint (grip_action rescales the
       -1..1 gripper action into ctrlrange as a position target); source
       kp kept, MuJoCo-3.x kv attribute stripped (2.3.7 schema blocker)
     - all <default> classes inlined, zero default blocks (robosuite merge
       drops them)
     - mesh files resolve via ../robots/soarm101/assets/ into the 02-01
       vendored STL dir (robosuite resolve_asset_dependency joins the XML
       folder with the file attribute) -->
<mujoco model="soarm_gripper">
    <asset>
        <mesh name="wrist_roll_follower_so101_v1" file="../robots/soarm101/assets/wrist_roll_follower_so101_v1.stl"/>
        <mesh name="moving_jaw_so101_v1" file="../robots/soarm101/assets/moving_jaw_so101_v1.stl"/>
        <material name="wrist_roll_follower_so101_v1_material" rgba="1 0.82 0.12 1"/>
        <material name="moving_jaw_so101_v1_material" rgba="1 0.82 0.12 1"/>
    </asset>
    <actuator>
        <!-- Source SO101 gripper servo: kp 998.22 (kv stripped for 2.3.7),
             ctrlrange = source joint range, forcerange from source actuator. -->
        <position ctrllimited="true" ctrlrange="-0.17453 1.74533" joint="gripper" kp="998.22" name="gripper_jaw" forcelimited="true" forcerange="-3.35 3.35"/>
    </actuator>
    <worldbody>
        <body name="right_gripper" pos="0 0 0" quat="1 0 0 0">
            <site name="ft_frame" pos="0 0 0" size="0.01 0.01 0.01" rgba="1 0 0 1" type="sphere" group="1"/>
            <!-- Explicit inertial (approx. fixed-jaw share of the source
                 gripper body's 0.087 kg) so mesh density is not double-counted
                 across the visual + collision geom pair. Tune in plan 02-03. -->
            <inertial pos="0 -0.0002 -0.05" mass="0.034" diaginertia="2e-05 2e-05 1e-05"/>
            <!-- Fixed jaw: wrist_roll_follower_so101_v1 at its source-relative pose -->
            <geom type="mesh" contype="0" conaffinity="0" group="1" pos="8.32667e-17 -0.000218214 0.000949706" quat="0 1 0 0" mesh="wrist_roll_follower_so101_v1" material="wrist_roll_follower_so101_v1_material" name="fixed_jaw_visual"/>
            <geom type="mesh" group="0" contype="0" conaffinity="1" solref="0.02 1" friction="1 0.005 0.0001" condim="4" pos="8.32667e-17 -0.000218214 0.000949706" quat="0 1 0 0" mesh="wrist_roll_follower_so101_v1" name="fixed_jaw_collision"/>
            <!-- EEF frame at the source gripperframe site position (between the jaws) -->
            <body name="eef" pos="-0.0079 -0.0002 -0.0981" quat="1 0 0 0">
                <site name="grip_site" pos="0 0 0" size="0.01 0.01 0.01" rgba="1 0 0 0.5" type="sphere" group="1"/>
                <site name="ee" pos="0 0 0" size="0.01 0.01 0.01" rgba="0 0 1 0" type="sphere" group="1"/>
                <site name="ee_x" pos="0.1 0 0" size="0.005 .1" quat="0.707105 0 0.707108 0" rgba="1 0 0 0" type="cylinder" group="1"/>
                <site name="ee_y" pos="0 0.1 0" size="0.005 .1" quat="0.707105 0.707108 0 0" rgba="0 1 0 0" type="cylinder" group="1"/>
                <site name="ee_z" pos="0 0 0.1" size="0.005 .1" quat="1 0 0 0" rgba="0 0 1 0" type="cylinder" group="1"/>
                <site name="grip_site_cylinder" pos="0 0 0" size="0.005 10" rgba="0 1 0 0.3" type="cylinder" group="1"/>
            </body>
            <!-- Moving jaw at its source-relative pose, with the source
                 "gripper" hinge joint (sts3215 class values inlined) -->
            <body name="moving_jaw_so101_v1" pos="0.0202 0.0188 -0.0234" quat="0.707107 0.707107 -1.85362e-08 1.85362e-08">
                <joint axis="0 0 1" name="gripper" type="hinge" limited="true" range="-0.17453297762778586 1.7453291995659765" damping="0.6" frictionloss="0.052" armature="0.028"/>
                <inertial pos="-0.00157495 -0.0300244 0.0192755" mass="0.012" fullinertia="6.61427e-06 1.89032e-06 5.28738e-06 -3.19807e-07 -5.90717e-09 -1.09945e-07"/>
                <geom type="mesh" contype="0" conaffinity="0" group="1" pos="-5.55112e-17 -5.55112e-17 0.0189" quat="1 -0 3.00524e-16 -2.00834e-17" mesh="moving_jaw_so101_v1" material="moving_jaw_so101_v1_material" name="moving_jaw_visual"/>
                <geom type="mesh" group="0" contype="0" conaffinity="1" solref="0.02 1" friction="1 0.005 0.0001" condim="4" pos="-5.55112e-17 -5.55112e-17 0.0189" quat="1 -0 3.00524e-16 -2.00834e-17" mesh="moving_jaw_so101_v1" name="moving_jaw_collision"/>
            </body>
        </body>
    </worldbody>
    <sensor>
        <force name="force_ee" site="ft_frame"/>
        <torque name="torque_ee" site="ft_frame"/>
    </sensor>
</mujoco>
